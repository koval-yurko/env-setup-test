# Secrets for secret-probe. Copy to .env and edit. No quotes around values.
# A variable already set in the process environment wins over this file.

# --- Runtime (Go app) ---
PORT=8080
PROBE_SECRET=dummy-secret-from-dotenv
# Fine-grained PAT of a GitHub TEST account. Never shown on the page.
GITHUB_TOKEN=github_pat_replace_me

# --- AWS (Go app, AWS CLI, Terraform) ---
# Token-based: no `aws configure` or `aws sso login` needed.
# Never shown on the page. AWS_SESSION_TOKEN only for temporary keys (ASIA...).
AWS_ACCESS_KEY_ID=AKIA_replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_SESSION_TOKEN=
AWS_REGION=eu-west-1
# Block a fallback to the personal ~/.aws profiles of the host.
AWS_CONFIG_FILE=/dev/null
AWS_SHARED_CREDENTIALS_FILE=/dev/null

SSM_PARAM_NAME=/secret-probe/test/probe-param

# --- HCP Terraform (Makefile, Go app) ---
# Token-based: no `terraform login`. Never shown on the page.
# Runs are remote: AWS keys for the run are workspace variables in HCP Terraform.
TF_TOKEN_app_terraform_io=replace_me
TF_CLOUD_ORGANIZATION=my-test-org
TF_CLOUD_PROJECT=secret-probe
# Workspaces: `make tf-ws WS=<name>` selects or creates one (tag secret-probe).
# Ignore the host's ~/.terraformrc.
TF_CLI_CONFIG_FILE=/dev/null
