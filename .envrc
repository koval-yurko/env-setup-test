# direnv: load .env into the shell when you cd into this repo.
# A variable that the environment already sets (for example from a Software
# Factory secret store) wins over .env, like in the Go app. direnv restores the
# outer environment before each reload, so this check sees the real outer value.
watch_file .env
if [[ -f .env ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line#export }
    [[ $line =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
    key=${BASH_REMATCH[1]}
    val=${BASH_REMATCH[2]}
    val=${val#[\"\']}
    val=${val%[\"\']}
    [[ -z $val || -n ${!key+x} ]] && continue
    export "$key=$val"
  done < .env
fi
